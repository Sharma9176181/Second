        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Task 1: Delivery Performance Classification (Calculated Field) Business Need Operations wants to track delivery efficiency. Task Classify orders as Fast or Delayed.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (Blinkit Orders Dataset)' name='federated.0vj2io30a85dk413o3uva1u2bpw5' />
          </datasources>
          <datasource-dependencies datasource='federated.0vj2io30a85dk413o3uva1u2bpw5'>
            <column caption='Delivery Category' datatype='string' name='[Calculation_1666914381783040]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Delivery_Time_Min] &lt;= 30 Then &apos;Fast&apos;&#13;&#10;ELSE &apos;Delayed&apos;&#13;&#10;END' />
            </column>
            <column caption='Delivery Time Min' datatype='integer' name='[Delivery_Time_Min]' role='measure' type='quantitative' />
            <column caption='Order ID' datatype='integer' name='[Order_ID]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1666914381783040]' derivation='None' name='[none:Calculation_1666914381783040:nk]' pivot='key' type='nominal' />
            <column-instance column='[Order_ID]' derivation='None' name='[none:Order_ID:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0vj2io30a85dk413o3uva1u2bpw5].[none:Calculation_1666914381783040:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Calculation_1666914381783040:nk]' member='&quot;Delayed&quot;' />
              <groupfilter function='member' level='[none:Calculation_1666914381783040:nk]' member='&quot;Fast&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.0vj2io30a85dk413o3uva1u2bpw5].[none:Calculation_1666914381783040:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='width' field='[federated.0vj2io30a85dk413o3uva1u2bpw5].[none:Calculation_1666914381783040:nk]' value='147' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
