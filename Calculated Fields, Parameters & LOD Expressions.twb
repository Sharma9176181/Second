    </worksheet>
    <worksheet name='Task 2'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Task 2: Loss-Making Orders Identification Blinkit Orders Assignment Questions Pwskills Business Need High sales do not always mean high profit. Task Identify orders resulting in loss.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (Blinkit Orders Dataset)' name='federated.0vj2io30a85dk413o3uva1u2bpw5' />
          </datasources>
          <datasource-dependencies datasource='federated.0vj2io30a85dk413o3uva1u2bpw5'>
            <column caption='Loss Flag' datatype='string' name='[Calculation_1666914383495169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [Profit] &lt; 0 Then &apos;Loss&apos;&#13;&#10;Else &apos;Profit&apos;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='real' name='[Profit]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Sales]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1666914383495169]' derivation='None' name='[none:Calculation_1666914383495169:nk]' pivot='key' type='nominal' />
            <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Sales]' derivation='Sum' name='[sum:Sales:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='width' field='[federated.0vj2io30a85dk413o3uva1u2bpw5].[none:Calculation_1666914383495169:nk]' value='178' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <color column='[federated.0vj2io30a85dk413o3uva1u2bpw5].[none:Category:nk]' />
              <text column='[federated.0vj2io30a85dk413o3uva1u2bpw5].[none:Category:nk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
              <style-rule element='pane'>
                <format attr='minwidth' value='-1' />
                <format attr='maxwidth' value='-1' />
              </style-rule>
            </style>
