    <worksheet name='Task 5'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Task 5: Customer/Product Detail Impact (INCLUDE LOD) Business Need The sales team wants average sales considering product-level detail, even when product is not shown. Task Create a calculation that finds the average sales at the product level, but allows the result to be used at a higher level (such as Category or Region). Use INCLUDE LOD. </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (Blinkit Orders Dataset)' name='federated.0vj2io30a85dk413o3uva1u2bpw5' />
          </datasources>
          <datasource-dependencies datasource='federated.0vj2io30a85dk413o3uva1u2bpw5'>
            <column caption='Avg Sales per Product' datatype='real' name='[Calculation_1666914389872644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ INCLUDE [Product_Name] : AVG([Sales]) }' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column caption='Product Name' datatype='string' name='[Product_Name]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Sales]' role='measure' type='quantitative' />
            <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1666914389872644]' derivation='Sum' name='[sum:Calculation_1666914389872644:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
        </panes>
        <rows>[federated.0vj2io30a85dk413o3uva1u2bpw5].[none:Category:nk]</rows>
        <cols>[federated.0vj2io30a85dk413o3uva1u2bpw5].[sum:Calculation_1666914389872644:qk]</cols>
      </table>
      <simple-id uuid='{0050D6B7-CB54-44AC-AEC0-C3CC1AD7882B}' />
    </worksheet>
