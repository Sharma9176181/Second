      <column caption='Delivery Category' datatype='string' name='[Calculation_1666914381783040]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Delivery_Time_Min] &lt;= 30 Then &apos;Fast&apos;&#13;&#10;ELSE &apos;Delayed&apos;&#13;&#10;END' />
      </column>
      <column caption='Loss Flag' datatype='string' name='[Calculation_1666914383495169]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Profit] &lt; 0 Then &apos;Loss&apos;&#13;&#10;Else &apos;Profit&apos;&#13;&#10;END' />
      </column>
      <column caption='Top N' datatype='boolean' name='[Calculation_1666914387103746]' role='measure' type='nominal'>
